{
  "openapi": "3.0.3",
  "info": {
    "title": "Todoist API (Workshop Subset)",
    "version": "1",
    "description": "Minimal OpenAPI spec covering endpoints used in Web APIs workshop README"
  },
  "servers": [
    { "url": "https://api.todoist.com" }
  ],
  "security": [
    { "bearerAuth": [] }
  ],
  "paths": {
    "/api/v1/projects": {
      "get": {
        "summary": "Get all projects",
        "operationId": "getProjects",
        "tags": ["Projects"],
        "responses": {
          "200": {
            "description": "List of projects",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "results": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/Project" }
                    }
                  }
                }
              }
            }
          },
          "401": { "description": "Unauthorized - missing or invalid token" }
        }
      },
      "post": {
        "summary": "Create a project",
        "operationId": "createProject",
        "tags": ["Projects"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ProjectCreate" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Created project",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Project" }
              }
            }
          },
          "401": { "description": "Unauthorized" }
        }
      }
    },
    "/api/v1/projects/{project_id}": {
      "get": {
        "summary": "Get a project by ID",
        "operationId": "getProject",
        "tags": ["Projects"],
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Project details",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Project" }
              }
            }
          },
          "401": { "description": "Unauthorized" },
          "404": { "description": "Project not found" }
        }
      }
    },
    "/api/v1/tasks": {
      "get": {
        "summary": "Get all tasks",
        "operationId": "getTasks",
        "tags": ["Tasks"],
        "responses": {
          "200": {
            "description": "List of tasks",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "results": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/Task" }
                    }
                  }
                }
              }
            }
          },
          "401": { "description": "Unauthorized" }
        }
      },
      "post": {
        "summary": "Create a task",
        "operationId": "createTask",
        "tags": ["Tasks"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/TaskCreate" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Created task",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Task" }
              }
            }
          },
          "401": { "description": "Unauthorized" }
        }
      }
    },
    "/api/v1/tasks/{task_id}": {
      "get": {
        "summary": "Get a task by ID",
        "operationId": "getTask",
        "tags": ["Tasks"],
        "parameters": [
          {
            "name": "task_id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Task details",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Task" }
              }
            }
          },
          "401": { "description": "Unauthorized" },
          "404": { "description": "Task not found" }
        }
      },
      "post": {
        "summary": "Update a task",
        "operationId": "updateTask",
        "tags": ["Tasks"],
        "parameters": [
          {
            "name": "task_id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/TaskUpdate" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated task",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Task" }
              }
            }
          },
          "401": { "description": "Unauthorized" },
          "404": { "description": "Task not found" }
        }
      },
      "delete": {
        "summary": "Delete a task",
        "operationId": "deleteTask",
        "tags": ["Tasks"],
        "parameters": [
          {
            "name": "task_id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "204": { "description": "Task deleted" },
          "401": { "description": "Unauthorized" },
          "404": { "description": "Task not found" }
        }
      }
    },
    "/api/v1/tasks/{task_id}/close": {
      "post": {
        "summary": "Close (complete) a task",
        "operationId": "closeTask",
        "tags": ["Tasks"],
        "parameters": [
          {
            "name": "task_id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "204": { "description": "Task closed" },
          "401": { "description": "Unauthorized" },
          "404": { "description": "Task not found" }
        }
      }
    },
    "/api/v1/tasks/filter": {
      "get": {
        "summary": "Filter tasks by query",
        "operationId": "filterTasks",
        "tags": ["Tasks"],
        "parameters": [
          {
            "name": "query",
            "in": "query",
            "required": true,
            "schema": { "type": "string" },
            "example": "search:Consume"
          }
        ],
        "responses": {
          "200": {
            "description": "Filtered tasks",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "results": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/Task" }
                    }
                  }
                }
              }
            }
          },
          "401": { "description": "Unauthorized" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "API token from Todoist Developer settings"
      }
    },
    "schemas": {
      "Project": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "example": "6XGgm6PHrGgMpCFX" },
          "name": { "type": "string", "example": "Inbox" },
          "color": { "type": "string", "example": "charcoal" },
          "description": { "type": "string" },
          "parent_id": { "type": "string", "nullable": true },
          "child_order": { "type": "integer", "example": 1 },
          "is_collapsed": { "type": "boolean" },
          "is_archived": { "type": "boolean" },
          "is_deleted": { "type": "boolean" },
          "is_favorite": { "type": "boolean" },
          "is_frozen": { "type": "boolean" },
          "is_shared": { "type": "boolean" },
          "inbox_project": { "type": "boolean" },
          "view_style": { "type": "string", "example": "list" },
          "default_order": { "type": "integer" },
          "creator_uid": { "type": "string", "nullable": true },
          "created_at": { "type": "string", "format": "date-time", "nullable": true },
          "updated_at": { "type": "string", "format": "date-time", "nullable": true },
          "can_assign_tasks": { "type": "boolean" },
          "can_comment": { "type": "boolean" },
          "access": { "type": "string" },
          "role": { "type": "string" },
          "public_key": { "type": "string" },
          "goal_ids": { "type": "array", "items": { "type": "string" } }
        }
      },
      "ProjectCreate": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string", "example": "API Skill Goals" },
          "color": { "type": "string" },
          "parent_id": { "type": "string" },
          "view_style": { "type": "string", "enum": ["list", "board"] },
          "is_favorite": { "type": "boolean" }
        }
      },
      "Task": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "example": "6XGgmFVcrG5RRjVr" },
          "user_id": { "type": "string", "example": "1234567" },
          "project_id": { "type": "string", "example": "6XGgm6PHrGgMpCFX" },
          "section_id": { "type": "string", "nullable": true },
          "parent_id": { "type": "string", "nullable": true },
          "content": { "type": "string", "example": "Buy milk" },
          "description": { "type": "string" },
          "priority": { "type": "integer", "minimum": 1, "maximum": 4, "example": 1 },
          "child_order": { "type": "integer" },
          "day_order": { "type": "integer" },
          "labels": { "type": "array", "items": { "type": "string" } },
          "checked": { "type": "boolean", "example": false },
          "is_collapsed": { "type": "boolean" },
          "is_deleted": { "type": "boolean" },
          "added_at": { "type": "string", "format": "date-time" },
          "added_by_uid": { "type": "string", "nullable": true },
          "assigned_by_uid": { "type": "string", "nullable": true },
          "responsible_uid": { "type": "string", "nullable": true },
          "completed_at": { "type": "string", "format": "date-time", "nullable": true },
          "completed_by_uid": { "type": "string", "nullable": true },
          "updated_at": { "type": "string", "format": "date-time" },
          "due": { "$ref": "#/components/schemas/Due" },
          "deadline": { "$ref": "#/components/schemas/Deadline" },
          "duration": { "$ref": "#/components/schemas/Duration" },
          "note_count": { "type": "integer" },
          "completed_count": { "type": "integer" },
          "postponed_count": { "type": "integer" },
          "goal_ids": { "type": "array", "items": { "type": "string" } }
        }
      },
      "TaskCreate": {
        "type": "object",
        "required": ["content"],
        "properties": {
          "content": { "type": "string", "example": "Consume APIs" },
          "project_id": { "type": "string", "example": "6XGgm6PHrGgMpCFX" },
          "section_id": { "type": "string" },
          "parent_id": { "type": "string" },
          "description": { "type": "string" },
          "priority": { "type": "integer", "minimum": 1, "maximum": 4 },
          "labels": { "type": "array", "items": { "type": "string" } },
          "due_string": { "type": "string", "example": "tomorrow" },
          "due_date": { "type": "string", "format": "date" },
          "due_datetime": { "type": "string", "format": "date-time" }
        }
      },
      "TaskUpdate": {
        "type": "object",
        "properties": {
          "content": { "type": "string" },
          "description": { "type": "string" },
          "priority": { "type": "integer", "minimum": 1, "maximum": 4 },
          "labels": { "type": "array", "items": { "type": "string" } },
          "due_string": { "type": "string" },
          "due_date": { "type": "string", "format": "date" },
          "due_datetime": { "type": "string", "format": "date-time" }
        }
      },
      "Due": {
        "type": "object",
        "nullable": true,
        "properties": {
          "date": { "type": "string", "example": "2025-02-12" },
          "string": { "type": "string", "example": "tomorrow" },
          "datetime": { "type": "string", "format": "date-time" },
          "timezone": { "type": "string" },
          "is_recurring": { "type": "boolean" },
          "lang": { "type": "string", "example": "en" }
        }
      },
      "Deadline": {
        "type": "object",
        "nullable": true,
        "properties": {
          "date": { "type": "string", "example": "2025-02-12" },
          "lang": { "type": "string", "example": "en" }
        }
      },
      "Duration": {
        "type": "object",
        "nullable": true,
        "properties": {
          "amount": { "type": "integer", "example": 30 },
          "unit": { "type": "string", "example": "minute" }
        }
      }
    }
  }
}
